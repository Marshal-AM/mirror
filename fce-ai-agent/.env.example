# Mirror AI-agent FCE — isolated from fce-matching-engine.
# Copy to .env on the GCE VM. Do NOT copy matching EXT_PROXY_URL.

LANGUAGE=typescript

PROXY_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxx"
INITIAL_OWNER="0x123.."
DEPLOYMENT_PRIVATE_KEY="123..."

# TEE governance (must match post-build set-governance)
# GOVERNANCE_SIGNERS="0xAbc..."
# GOVERNANCE_THRESHOLD=1

CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
ADDRESSES_FILE=./config/coston2/deployed-addresses.json

LOCAL_MODE=false
SIMULATED_TEE=true

NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# Written by start-services.sh --tunnel (AI tunnel only). Leave unset until then.
# EXT_PROXY_URL=https://<ai-trycloudflare-host>

# Isolated host ports — do not reuse matching 6673/6674/6382
REDIS_BIND=127.0.0.1:6383
EXT_PROXY_INTERNAL_BIND=0.0.0.0:6683
EXT_PROXY_EXTERNAL_BIND=0.0.0.0:6684
COMPOSE_NETWORK=extension-scaffold-ai-agent
TUNNEL_TARGET=http://host.docker.internal:6684

CHAIN_ID=114
TEE_VERSION=v0.1.0-ai

# Live SCORE_V1 — same token as matching + Vercel. Leave SYNTHETIC_OUTCOME_FIXTURE unset.
TEE_INTERNAL_TOKEN=mirror-coston2-tee-internal
MATCHING_ENGINE_PRIVATE_LOG_URL=http://host.docker.internal:7702
# Optional: Vercel fill log (same token). Example: https://YOUR-APP.vercel.app/api/outcomes
MIRROR_OUTCOME_LOG_URL=
# SYNTHETIC_OUTCOME_FIXTURE=1
